<ui:UXML xmlns:ui="UnityEngine.UIElements">

    <!--
        PauseMenu.uxml
        Full-screen dim overlay with a centred panel.
        Sprites, colours, and event wiring done at runtime by PauseMenu.cs.
    -->

    <Style src="PauseMenu.uss" />

    <!-- Full-screen semi-transparent overlay -->
    <ui:VisualElement name="overlay" class="pm-overlay">

        <!-- Centred panel -->
        <ui:VisualElement name="panel-root" class="pm-panel">

            <ui:Label class="pm-title" text="PAUSED" />

            <ui:VisualElement class="pm-divider" />

            <ui:Label class="pm-section-label" text="Settings" />

            <ui:Toggle name="edge-scroll-toggle" class="pm-toggle" label="Edge Scroll" />

            <ui:VisualElement class="pm-divider" />

            <ui:Label class="pm-section-label" text="Audio" />

            <!-- SFX volume slider -->
            <ui:VisualElement class="pm-slider-row">
                <ui:Label class="pm-slider-label" text="SFX" />
                <ui:Slider name="sfx-volume-slider" class="pm-slider"
                           low-value="0" high-value="100" />
                <ui:Label name="sfx-volume-value" class="pm-slider-value" text="80" />
            </ui:VisualElement>

            <!-- Music volume slider -->
            <ui:VisualElement class="pm-slider-row">
                <ui:Label class="pm-slider-label" text="Music" />
                <ui:Slider name="music-volume-slider" class="pm-slider"
                           low-value="0" high-value="100" />
                <ui:Label name="music-volume-value" class="pm-slider-value" text="70" />
            </ui:VisualElement>

            <ui:VisualElement class="pm-divider" />

            <ui:Button name="keybindings-button" class="pm-button pm-keybind-btn" text="Key Bindings" />

            <ui:VisualElement class="pm-divider-small" />

            <ui:Button name="resume-button" class="pm-button pm-resume-btn" text="Resume" />

        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>

/*
    RadialMenu.uss  —  Clair Obscur: Expedition 33 inspired
    ─────────────────────────────────────────────────────────
    Vertical stack of dark glass cards.
    Small circle indicator on the left, bold white label.
    No rotation anywhere.
*/

/* ── Overlay & pivot ─────────────────────────────────────────────────────── */
.radial-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    /* picking-mode: Ignore is set via UXML attribute */
}

.radial-pivot {
    position: absolute;
    width: 0;
    height: 0;
    /* picking-mode: Ignore is set via UXML attribute */
}

/* ── List container — vertical stack, anchored right of the pivot ────────── */
.menu-list {
    position: absolute;
    left: 30px;    /* horizontal offset from the pivot (monster screen pos) */
    top: 0;        /* overridden each frame in C# to vertically centre the list */
    flex-direction: column;
    gap: 6px;
    width: 270px;
}

/* ══════════════════════════════════════════════════════════════════════════
   CARD  —  270 × 60 px dark glass, thin bright border on hover.
   Left accent bar fades in on hover. Circle dot on far left.
   ══════════════════════════════════════════════════════════════════════════ */
.menu-card {
    width:  270px;
    height:  60px;

    border-radius: 2px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 18);

    background-color: rgba(10, 10, 16, 210);

    flex-direction: row;
    align-items: center;

    overflow: hidden;

    transition-property: background-color, border-color, border-left-width, border-left-color;
    transition-duration: 0.08s, 0.08s, 0.08s, 0.08s;
}

.menu-card:hover {
    background-color: rgba(30, 18, 18, 235);
    border-color:     rgba(200, 60, 60, 200);
    /* Thicker left edge on hover to mimic E33's selection indicator */
    border-left-width: 4px;
    border-left-color: rgba(220, 60, 60, 255);
}

.menu-card:active {
    background-color: rgba(160, 110, 0, 240);
    border-color:     rgba(255, 210, 0, 255);
    border-left-width: 4px;
    border-left-color: rgba(255, 230, 0, 255);
}

/* ── Circle indicator — mirrors E33's controller-button circles ──────────── */
.menu-card-dot {
    width:  18px;
    height: 18px;
    border-radius: 9px;
    border-width: 2px;
    border-color: rgba(200, 200, 220, 140);
    background-color: rgba(0, 0, 0, 0);

    /* fixed distance from left edge */
    position: absolute;
    left: 16px;
    top:  21px;   /* (60 - 18) / 2 */

    transition-property: border-color, background-color;
    transition-duration: 0.08s;
}

.menu-card:hover .menu-card-dot {
    border-color: rgba(230, 80, 80, 255);
    background-color: rgba(200, 40, 40, 60);
}

.menu-card:active .menu-card-dot {
    border-color: rgba(255, 220, 0, 255);
    background-color: rgba(200, 150, 0, 80);
}

/* ── Action label ────────────────────────────────────────────────────────── */
.menu-card-label {
    position: absolute;
    left:   46px;   /* clears the dot (16 + 18 + 12 gap) */
    right:  14px;
    top:     0;
    bottom:  0;

    font-size: 22px;
    -unity-font-style: bold;
    color: rgba(235, 235, 235, 230);
    -unity-text-align: middle-left;
    white-space: nowrap;
    letter-spacing: 1px;

    transition-property: color;
    transition-duration: 0.08s;
}

.menu-card:hover .menu-card-label {
    color: rgba(255, 255, 255, 255);
}

.menu-card:active .menu-card-label {
    color: rgba(20, 15, 5, 255);
}

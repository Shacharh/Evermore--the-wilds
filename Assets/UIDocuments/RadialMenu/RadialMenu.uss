/*
    RadialMenu.uss  —  Clair Obscur: Expedition 33 inspired
    ─────────────────────────────────────────────────────────
    Vertical stack of dark glass cards.
    Small circle indicator on the left, bold white label.
    No rotation anywhere.
*/

/* ── Overlay & pivot ─────────────────────────────────────────────────────── */
.radial-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    /* picking-mode: Ignore is set via UXML attribute */
}

.radial-pivot {
    position: absolute;
    width: 0;
    height: 0;
    /* picking-mode: Ignore is set via UXML attribute */
}

/* ── List container — vertical stack, anchored right of the pivot ────────── */
.menu-list {
    position: absolute;
    left: 30px;    /* horizontal offset from the pivot (monster screen pos) */
    top: 0;        /* overridden each frame in C# to vertically centre the list */
    flex-direction: column;
    gap: 6px;
    width: 310px;
}

/* ══════════════════════════════════════════════════════════════════════════
   CARD  —  270 × 60 px dark glass, thin bright border on hover.
   Left accent bar fades in on hover. Circle dot on far left.
   ══════════════════════════════════════════════════════════════════════════ */
.menu-card {
    width:  310px;
    height:  60px;

    border-radius: 2px;
    border-width: 0;              /* no white outline */
    border-left-width: 0;
    border-left-color: rgba(220, 60, 60, 0);

    background-color: rgba(10, 10, 16, 210);
    background-size: 100% 100%;   /* force sprite to stretch across the full card */

    flex-direction: row;
    align-items: center;

    overflow: hidden;

    transition-property: border-left-width, border-left-color, -unity-background-image-tint-color;
    transition-duration: 0.08s, 0.08s, 0.08s;
}

.menu-card:hover {
    border-left-width: 4px;
    border-left-color: rgba(220, 60, 60, 255);
    -unity-background-image-tint-color: rgba(220, 170, 170, 255);
}

.menu-card:active {
    border-left-width: 4px;
    border-left-color: rgba(255, 230, 0, 255);
    -unity-background-image-tint-color: rgba(255, 230, 140, 255);
}

/* ── Circle indicator — mirrors E33's controller-button circles ──────────── */
.menu-card-dot {
    width:  18px;
    height: 18px;
    border-radius: 9px;
    border-width: 2px;
    border-color: rgba(200, 200, 220, 140);
    background-color: rgba(0, 0, 0, 0);

    position: absolute;
    left: 26px;   /* clear the pointed arrow tip */
    top:  21px;   /* (60 - 18) / 2 — vertically centred */

    transition-property: border-color, background-color;
    transition-duration: 0.08s;
}

.menu-card:hover .menu-card-dot {
    border-color: rgba(230, 80, 80, 255);
    background-color: rgba(200, 40, 40, 60);
}

.menu-card:active .menu-card-dot {
    border-color: rgba(255, 220, 0, 255);
    background-color: rgba(200, 150, 0, 80);
}

/* ── Action label — centred across the full card ─────────────────────────── */
.menu-card-label {
    position: absolute;
    left:   44px;   /* clear the dot on the left */
    right:  75px;   /* stop before the AP text on the right */
    top:    0;
    bottom: 0;

    font-size: 20px;
    -unity-font-style: bold;
    color: rgba(235, 235, 235, 230);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;   /* clip if still too long rather than crossing AP */
    letter-spacing: 1px;

    transition-property: color;
    transition-duration: 0.08s;
}

.menu-card:hover .menu-card-label {
    color: rgba(255, 255, 255, 255);
}

.menu-card:active .menu-card-label {
    color: rgba(20, 15, 5, 255);
}

/* ── AP cost label — shown only on attack cards (hidden via C# otherwise) ── */
.menu-card-ap {
    position: absolute;
    right:  32px;      /* pulled in from edge so it clears the arrow tip */
    top:     0;
    bottom:  0;

    font-size: 18px;
    -unity-font-style: bold;
    color: rgba(40, 70, 160, 255);   /* dark navy — visible against grey without standing out */
    -unity-text-align: middle-right;
    white-space: nowrap;
}
